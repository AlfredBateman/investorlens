# No environment variables are required to run InvestorLens locally.
# It uses SQLite (prisma/dev.db) — no database server, no cloud service, nothing else to configure.

# --- Optional: AI transcript analysis (/ai/transcripts) ------------------------------
# Off by default. To turn it on, set both of these and restart the server.
# Transcript text you submit is sent to Google's Gemini API.
# AI_FEATURES=on
# GEMINI_API_KEY=your-gemini-api-key-here

# Model override (optional; defaults to gemini-3.8-flash if unset)
# GEMINI_MODEL=gemini-3.8-flash

# --- Optional: sitemap.xml base URL --------------------------------------------------
# Only affects the generated sitemap; irrelevant for local use.
# NEXT_PUBLIC_APP_URL=https://your-domain.example
